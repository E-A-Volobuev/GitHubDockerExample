# Образ берётся из удалённого репозитория GitHub Container Registry
FROM ghcr.io/e-a-volobuev/githubdockerexample:latest

# Дополнительные настройки при необходимости
# Development — чтобы был доступен Swagger (в Production он отключён в Program.cs)
ENV ASPNETCORE_ENVIRONMENT=Development
EXPOSE 80

ENTRYPOINT ["dotnet", "GitHubDockerExample.dll"]
